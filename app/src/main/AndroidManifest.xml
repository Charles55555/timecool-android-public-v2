<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Import du carnet d'adresses, demandé à l'exécution et uniquement
         au moment où l'utilisateur lance l'import. L'application reste
         pleinement utilisable si la permission est refusée. -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- Lecture du QR code d'appairage affiche par TimeCool Web.
         La camera n'est pas requise : un appareil sans camera installe
         quand meme l'application et saisit le code a 6 chiffres. -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Installation de la mise a jour depuis l'application. Sans elle,
         Android refuse l'intent d'installation sans aucun message. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Position, demandée à l'exécution et uniquement quand la page
         appelle navigator.geolocation (recherche de professionnels à
         proximité, estimation de trajet). Un refus dégrade la fonction
         au lieu de la bloquer : voir tcObtenirPosition() côté JS. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Écriture dans le dossier public Téléchargements (export des clés
         API). Seulement sur Android 9 et moins : à partir d'Android 10
         (Q, API 29), MediaStore.Downloads y écrit sans aucune permission —
         maxSdkVersion garantit que celle-ci ne s'applique pas au-delà. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|locale|layoutDirection|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Un APK telecharge ne peut pas etre passe a l'installateur par
             son chemin brut : depuis Android 7 cela leve
             FileUriExposedException. Le FileProvider fournit une URI
             content:// que l'installateur est autorise a lire. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>
